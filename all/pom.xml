<?xml version="1.0" encoding="UTF-8" ?>
<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
>
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>fr.nivcoo.kraftink</groupId>
        <artifactId>KraftLink-parent</artifactId>
        <version>1.4.1-dev</version>
    </parent>
    <artifactId>KraftLink</artifactId>
    <dependencies>
        <dependency>
            <groupId>fr.nivcoo.kraftink</groupId>
            <artifactId>KraftLink-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>fr.nivcoo.kraftink</groupId>
            <artifactId>KraftLink-Bukkit</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>fr.nivcoo.kraftink</groupId>
            <artifactId>KraftLink-Velocity</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>fr.nivcoo.kraftink</groupId>
            <artifactId>KraftLink-Hytale</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>fr.nivcoo.kraftink</groupId>
            <artifactId>KraftLink-Sponge</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>fr.nivcoo.kraftink</groupId>
            <artifactId>KraftLink-Nukkit</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
    <build>
        <finalName>${project.artifactId}-${project.version}-thin</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <configuration>
                    <outputFile>${project.build.directory}/KraftLink-platforms-${project.version}.jar</outputFile>
                    <transformers>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                    </transformers>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
